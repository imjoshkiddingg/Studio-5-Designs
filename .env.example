# Contact form (Resend) — copy to .env.local and fill in for local testing.
# In production, set these in Vercel → Settings → Environment Variables.

# Required: your Resend API key (resend.com → API Keys)
RESEND_API_KEY=

# Optional: sender address. Must be on a Resend-verified domain in production.
# Defaults to the Resend sandbox sender if unset:
#   CONTACT_FROM="Studio 5 Website <onboarding@resend.dev>"
# Once studio5designs.com is verified with Resend, use e.g.:
#   CONTACT_FROM="Studio 5 Website <website@studio5designs.com>"
CONTACT_FROM=

# Optional: comma-separated recipient addresses.
# Defaults to: josh@hellostudio5designs.com,hello@studio5designs.com
# NOTE: with the Resend sandbox sender, delivery only works to your
# Resend account's own email until a domain is verified.
CONTACT_TO=
